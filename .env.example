# MONOLITH Algo Trading Platform — environment variables
# Copy to .env and fill in values. Never commit .env to git.

# System
MONOLITH_MODE=paper
MONOLITH_LOG_LEVEL=INFO

# QUIK LUA bridge
QUIK_HOST=127.0.0.1
QUIK_PORT=34130

# Broker
BROKER_NAME=sber
BROKER_ACCOUNT_ID=
BROKER_CLIENT_CODE=
TINKOFF_TOKEN=
TINKOFF_SANDBOX=true
ALOR_TOKEN=
FINAM_TOKEN=

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# AI
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Database
DATABASE_URL=sqlite+aiosqlite:///hedge_fund/data/monolith.db

# ML
ML_MODELS_DIR=hedge_fund/ml/models
ML_AUTO_RETRAIN=true
ML_DRIFT_PSI_THRESHOLD=0.2
