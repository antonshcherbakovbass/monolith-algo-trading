# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/
env/

# Secrets — never commit
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test / cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Runtime data
hedge_fund/logs/*.log
hedge_fund/logs/runtime_state.json
hedge_fund/logs/control.json
*.db
*.db-journal
market_data.db

# Config backups with possible secrets
hedge_fund/config/backups/

# Historical CSV dumps (large)
hedge_fund/data/historical/*.csv

# OS
.DS_Store
Thumbs.db
desktop.ini

# Docker volumes
docker-data/

# Large build artifacts (use GitHub Releases instead)
dist_installers/windows/*.exe
dist_installers/windows/*.msi

# Keep bootstrap models — they are intentional
!hedge_fund/ml/models/
!hedge_fund/ml/models/*.pkl
!hedge_fund/ml/models/*.json
